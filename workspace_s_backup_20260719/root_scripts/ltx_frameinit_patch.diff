+def _env_flag(name: str, default: bool = False) -> bool:
+    value = os.environ.get(name)
+    if value is None:
+        return default
+    return value.strip().lower() in {"1", "true", "yes", "on"}
+
+
+def _env_float(name: str, default: float) -> float:
+    value = os.environ.get(name)
+    if value is None or not value.strip():
+        return default
+    try:
+        return float(value)
+    except ValueError:
+        logger.warning("Invalid %s=%r; using %.4f", name, value, default)
+        return default
+
+
+def _env_int(name: str, default: int) -> int:
+    value = os.environ.get(name)
+    if value is None or not value.strip():
+        return default
+    try:
+        return int(value)
+    except ValueError:
+        logger.warning("Invalid %s=%r; using %d", name, value, default)
+        return default
+
+
+def _latent_spatial_lowpass(latents: torch.Tensor, kernel_size: int) -> torch.Tensor:
+    """Low-pass filter latent videos over H/W while preserving temporal layout."""
+    if kernel_size <= 1:
+        return latents
+    h, w = latents.shape[-2:]
+    kernel_size = min(kernel_size, h if h % 2 == 1 else h - 1, w if w % 2 == 1 else w - 1)
+    if kernel_size < 3:
+        return latents
+    if kernel_size % 2 == 0:
+        kernel_size -= 1
+    padding = kernel_size // 2
+    return F.avg_pool3d(
+        latents,
+        kernel_size=(1, kernel_size, kernel_size),
+        stride=1,
+        padding=(0, padding, padding),
+        count_include_pad=False,
+    )
+
